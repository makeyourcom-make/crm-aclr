// ============================================================================
// USER
// ============================================================================

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(COMMERCIAL)
  isActive     Boolean @default(true)

  // Paramètres rémunération — surchargent les défauts globaux
  tauxCommissionSignature      Decimal @default("0.25") @db.Decimal(5, 4)
  tauxCommissionRenouvellement Decimal @default("0.10") @db.Decimal(5, 4)
  garantieMensuelle            Decimal @default("2500.00") @db.Decimal(12, 2)
  forfaitFrais                 Decimal @default("250.00") @db.Decimal(12, 2)

  // Signature email personnalisée (HTML pour le module Emails — étape 26)
  signatureEmailHtml String? @db.Text

  // Coords personnelles (apparaissent sur la facture mensuelle PDF)
  iban      String?
  telephone String?
  adresse   String?

  // ========== Fiche RH (admin uniquement) ==========
  dateNaissance       DateTime?
  numeroAVS           String?    // 756.XXXX.XXXX.XX (Suisse)
  contactUrgenceNom   String?
  contactUrgenceTel   String?
  typeContrat         TypeContrat?
  dateEntree          DateTime?  // date d'embauche
  dateSortie          DateTime?  // si l'employé est parti
  pourcentageActivite Int?       @default(100) // 100, 80, 50, etc.
  salaireBase         Decimal?   @db.Decimal(12, 2)
  notesRH             String?    @db.Text

  // Relations
  prospectsAssignes Prospect[]
  dealsAssignes     Deal[]
  contratsAssignes  Contract[]
  activities        Activity[]
  commissions       Commission[]
  invoices          Invoice[]
  emails            Email[]
  stats             Stat[]
  objectives        Objective[]
  documentsRH       EmployeeDocument[]
  expensesCreated   Expense[]

  @@index([email])
  @@map("users")
}

enum TypeContrat {
  CDI
  CDD
  MANDAT
  STAGE
  ESSAI
}

// ============================================================================
// EMPLOYEE DOCUMENT — contrat de travail, certificats, fiches de paie…
// ============================================================================

model EmployeeDocument {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type       EmployeeDocumentType
  titre      String
  fileUrl    String // chemin /uploads/rh/{userId}/{file}
  fileSize   Int?
  uploadedBy String? // userId qui a uploadé

  @@index([userId])
  @@map("employee_documents")
}

enum EmployeeDocumentType {
  CONTRAT_TRAVAIL
  AVENANT
  FICHE_SALAIRE
  CERTIFICAT_TRAVAIL
  DIPLOME
  PIECE_IDENTITE
  AUTRE
}

// ============================================================================
// EXPENSE — charge de l'entreprise (ticket scanné + OCR)
// ============================================================================

model Expense {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  date          DateTime         // date du ticket (facture/quittance)
  dateReglement DateTime?        // date à laquelle la charge a été débitée du compte (réconciliation bancaire)
  categorie     ExpenseCategorie
  fournisseur   String?
  description   String?
  reference     String?          // numéro de ticket / facture du fournisseur

  /// Statut de paiement (pour la réconciliation mensuelle avec le relevé bancaire)
  statutPaiement ExpenseStatutPaiement @default(EN_ATTENTE)

  /// Montants (HT = hors taxes, TVA, TTC = total)
  montantHT  Decimal @db.Decimal(12, 2)
  tauxTVA    Decimal @default("0.077") @db.Decimal(5, 4) // 7.7% standard suisse
  montantTVA Decimal @db.Decimal(12, 2)
  montantTTC Decimal @db.Decimal(12, 2)

  /// TVA récupérable (par défaut oui pour B2B)
  tvaRecuperable Boolean @default(true)

  methodPaiement MethodPaiement?

  /// Ticket scanné (URL du fichier dans /public/expenses)
  ticketUrl  String?
  ticketName String? // nom de fichier d'origine

  /// Trace OCR : payload brut renvoyé par le modèle vision (audit)
  ocrRawJson String? @db.Text
  /// Indique si les champs ont été pré-remplis par OCR (vs saisis à la main)
  ocrUtilise Boolean @default(false)

  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  /// Lien vers un client (Prospect) pour les charges directement attribuables :
  /// hosting d'un client, sous-traitance, etc. NULL = charge interne ou
  /// multi-clients (voir `allocations` pour le split).
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  prospectId String?

  /// Pièces justificatives multiples (preuves de paiement complémentaires,
  /// 2e facture liée au même mouvement, etc.). Le ticket "principal" reste
  /// dans ticketUrl/ticketName ci-dessus.
  attachments ExpenseAttachment[]

  /// Pour les charges multi-clients (ex. Google Ads, Lucas) : ventilation
  /// par prospect. Si vide, la charge entière est imputée à `prospect` (ou
  /// considérée interne si `prospectId` est NULL).
  allocations ExpenseAllocation[]

  /// Si cette charge a été générée automatiquement par une récurrence, lien
  /// vers le template parent (pour retracer / suspendre la série).
  recurrence   ExpenseRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  recurrenceId String?

  @@index([date])
  @@index([dateReglement])
  @@index([statutPaiement])
  @@index([categorie])
  @@index([prospectId])
  @@index([recurrenceId])
  @@map("expenses")
}

enum ExpenseStatutPaiement {
  EN_ATTENTE     // charge enregistrée, pas encore débitée du compte
  PAYE           // débit confirmé sur relevé bancaire (dateReglement renseignée)
  LITIGE         // débit contesté (ex. doublon LWS)
  REMBOURSE      // débit récupéré (annulation, remboursement)
}

/// Template de charge récurrente. Permet de générer automatiquement chaque mois
/// (ou autre fréquence) une charge en EN_ATTENTE qu'il suffit ensuite d'attacher
/// au ticket réel reçu. Utile pour Sunrise, Workspace, Lucas, LWS, etc.
model ExpenseRecurrence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label       String           // nom du template (ex. "Sunrise mobile + internet")
  categorie   ExpenseCategorie
  fournisseur String?
  description String?

  /// Montant moyen estimé (TTC). Sert à pré-remplir la charge générée.
  montantEstime Decimal @db.Decimal(12, 2)
  tauxTVA       Decimal @default("0.077") @db.Decimal(5, 4)

  /// Fréquence : MENSUEL = chaque 1er du mois, TRIMESTRIEL = 1er jan/avr/juil/oct, ANNUEL = 1er jan
  frequence ExpenseRecurrenceFrequence @default(MENSUEL)

  /// Jour du mois où la charge est attendue (1-28). NULL = 1er.
  jourMois Int?

  /// Si rattachée à un client : la charge générée sera pré-liée à ce prospect.
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  prospectId String?

  /// Si false, plus de génération automatique (série suspendue).
  actif Boolean @default(true)

  /// Date de fin (exclue) — passé cette date, plus de génération.
  dateFin DateTime?

  /// Charges générées par ce template
  expenses Expense[]

  @@index([actif, frequence])
  @@index([prospectId])
  @@map("expense_recurrences")
}

enum ExpenseRecurrenceFrequence {
  MENSUEL
  BIMESTRIEL
  TRIMESTRIEL
  SEMESTRIEL
  ANNUEL
}

/// Ventilation d'une charge sur plusieurs clients (P&L par client).
/// Ex. Google Ads 1789.93 CHF = 600 SP Industriel + 800 LocFactory + 389.93 Passeport.
/// La somme des montantHT des allocations doit (idéalement) égaler le montantHT
/// de l'Expense parente — non contraint en DB pour permettre des allocations
/// partielles.
model ExpenseAllocation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String

  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  prospectId String

  /// Montant HT alloué à ce client (en CHF, devise déjà convertie)
  montantHT Decimal @db.Decimal(12, 2)

  /// Note libre (ex: "Forfait Torgon 1 post" extrait de la facture Lucas)
  note String?

  @@index([expenseId])
  @@index([prospectId])
  @@map("expense_allocations")
}

model ExpenseAttachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String

  fileUrl  String // /expenses/{expenseId}/{filename}
  fileName String
  fileSize Int?
  /// Type libre pour distinguer "facture", "reçu carte", "ordre de virement", etc.
  kind     String? // FACTURE | RECU_CARTE | PREUVE_VIREMENT | AUTRE

  uploadedBy String? // userId

  @@index([expenseId])
  @@map("expense_attachments")
}

enum ExpenseCategorie {
  LOYER
  SOFTWARE_SAAS
  MARKETING
  PUBLICITE
  DEPLACEMENTS
  RESTAURATION
  MATERIEL_BUREAU
  ASSURANCES
  TELECOM
  FORMATION
  HONORAIRES
  IMPOTS
  BANQUE_FRAIS
  AUTRE
}

enum MethodPaiement {
  CARTE_BANCAIRE
  VIREMENT
  ESPECES
  TWINT
  PAYPAL
  PRELEVEMENT
  AUTRE
}

// ============================================================================
// PROSPECT
// ============================================================================

model Prospect {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  raisonSociale   String
  contactNom      String?
  contactPrenom   String?
  contactFonction String?

  email           String?
  telephone       String?
  telephoneMobile String?

  adresse    String?
  codePostal String?
  ville      String?
  canton     String? // code canton 2 lettres (VD, GE, VS, …) — libre pour souplesse
  pays       String  @default("Suisse")

  // Identifiants entreprise (pour affichage sur les factures)
  numeroIDE String? // CHE-XXX.XXX.XXX (Suisse) ou SIRET/SIREN/RCS (France)
  numeroTVA String? // CHE-XXX.XXX.XXX TVA ou FR-XX-XXXXXXXXX

  siteWeb   String?
  linkedIn  String?
  facebook  String?
  instagram String?

  secteur  ProspectSecteur?
  effectif Int?
  noga     String? // code NOGA suisse
  source   ProspectSource?

  statut ProspectStatut @default(NOUVEAU)

  assigneA   User?   @relation(fields: [assigneAId], references: [id], onDelete: SetNull)
  assigneAId String?

  notesGenerales String? @db.Text

  // Relations
  activities          Activity[]
  deals               Deal[]
  contracts           Contract[]
  emails              Email[]
  expenses            Expense[] // charges directement attribuables au client
  expenseAllocations  ExpenseAllocation[] // parts de charges multi-clients
  expenseRecurrences  ExpenseRecurrence[] // templates de charges récurrentes liées

  @@index([statut])
  @@index([assigneAId])
  @@index([secteur])
  @@index([canton])
  @@index([raisonSociale]) // recherche par nom
  @@map("prospects")
}

// ============================================================================
// ACTIVITY — appels, emails, RDV, notes
// ============================================================================

model Activity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Prospect lié (optionnel) — si null, l'activité est une "note interne"
  /// (ex: tâche d'équipe, rappel personnel) qui apparaît dans l'agenda
  /// sans être rattachée à un client.
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String

  type   ActivityType
  date   DateTime // créneau planifié OU effectif
  duree  Int? // durée déclarée en minutes
  duree2 Int? // durée RÉELLE en secondes (widget click-to-call)

  sujet   String
  contenu String? @db.Text

  statut        ActivityStatut    @default(PLANIFIE)
  resultat      ActivityResultat? // valide pour APPEL_* et RDV_*
  notesResultat String?           @db.Text // qualitatif libre saisi après l'appel

  // Self-relations pour la chaîne de relances :
  //   - rappelLeDeId : l'activité parente qui a généré CE rappel auto
  //   - prochaineActivityId : le rappel auto déclenché APRÈS celle-ci
  rappelLeDe   Activity?  @relation("ActivityRappel", fields: [rappelLeDeId], references: [id], onDelete: SetNull)
  rappelLeDeId String?
  rappels      Activity[] @relation("ActivityRappel")

  prochaineActivity   Activity?  @relation("ActivityProchaine", fields: [prochaineActivityId], references: [id], onDelete: SetNull)
  prochaineActivityId String?    @unique
  precedente          Activity[] @relation("ActivityProchaine")

  // Liens optionnels vers d'autres entités du CRM
  email   Email?  @relation(fields: [emailId], references: [id], onDelete: SetNull)
  emailId String?

  @@index([prospectId, date])
  @@index([userId, date])
  @@index([statut, date])
  @@index([type])
  @@map("activities")
}

// ============================================================================
// DEAL — opportunité commerciale dans le pipeline
// ============================================================================

model Deal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String

  assigneA   User   @relation(fields: [assigneAId], references: [id], onDelete: Restrict)
  assigneAId String

  titre       String
  description String? @db.Text

  montantPrevu Decimal   @db.Decimal(12, 2) // valeur 1 an attendue
  stage        DealStage @default(DECOUVERTE)
  probabilite  Int       @default(20) // 0-100

  closeAttenduLe DateTime?
  closeReelLe    DateTime?
  raisonPerte    String?   @db.Text

  // Produits envisagés / proposés (m2m implicite)
  productsProposes Product[]  @relation("DealProducts")
  /// Descriptions personnalisées par produit, format JSON map :
  /// { "productId": "détail du livrable, ex: site vitrine 5 pages + WP", ... }
  /// Affiché sur le contrat / facture comme suffixe de la désignation.
  productNotes     Json?
  contracts        Contract[]

  @@index([stage])
  @@index([assigneAId, stage])
  @@index([prospectId])
  @@map("deals")
}

// ============================================================================
// PRODUCT — catalogue
// ============================================================================

model Product {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom         String
  description String? @db.Text

  type      ProductType
  categorie ProductCategorie

  prixOneShot Decimal? @db.Decimal(12, 2)
  prixMensuel Decimal? @db.Decimal(12, 2)
  prixAnnuel  Decimal? @db.Decimal(12, 2)

  /// Coût direct de livraison du service (interne, pas affiché au client).
  /// Utilisé pour calculer la marge réelle par contrat.
  ///   - coutOneShot : setup, intégration, licences à l'install
  ///   - coutMensuel : hébergement, SaaS récurrent, ad spend mensuel, etc.
  coutOneShot Decimal? @db.Decimal(12, 2) @default(0)
  coutMensuel Decimal? @db.Decimal(12, 2) @default(0)

  /// Pour les packs : IDs des produits composants (JSON array de Product.id)
  composantsIds Json?

  isActive Boolean @default(true)

  // Relations
  deals              Deal[]              @relation("DealProducts")
  contracts          Contract[]          @relation("ContractProducts")
  clientInvoiceLines ClientInvoiceLine[]

  @@index([categorie, type])
  @@map("products")
}

// ============================================================================
// CONTRACT — contrat signé
// ============================================================================

model Contract {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  prospectId String

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  assigneA   User   @relation(fields: [assigneAId], references: [id], onDelete: Restrict)
  assigneAId String

  /// Format : ACLR-{YYYY}-{NNNN} séquentiel par année
  numero String @unique

  dateSignature DateTime
  dateDebut     DateTime
  dureeMois     Int      @default(12)

  statut           ContractStatut   @default(ATTENTE_SIGNATURE_CLIENT)
  modalitePaiement ModalitePaiement

  /// Traçabilité validation admin pour passage en ACTIF.
  valideParAdminId String?
  valideALe        DateTime?

  /// Devise dans laquelle les montants sont libellés.
  /// Par défaut : CHF (clients suisses). EUR pour les clients UE/France.
  /// Détermine aussi la devise des factures émises sous ce contrat.
  devise String @default("CHF") @db.VarChar(3)

  montantOneShot Decimal @db.Decimal(12, 2)
  montantMensuel Decimal @db.Decimal(12, 2)

  /// valeurAn1 = montantOneShot + montantMensuel * 12
  /// Stockée pour permettre les agrégations efficaces. Recalculée par l'app
  /// à chaque update — invariant testé.
  valeurAn1 Decimal @db.Decimal(12, 2)

  dateResiliation   DateTime?
  raisonResiliation String?   @db.Text

  // Relations
  products       Product[]        @relation("ContractProducts")
  payments       Payment[]
  commissions    Commission[]
  renewals       Renewal[]
  clientInvoices ClientInvoice[]
  options        ContractOption[]
  signatures     Signature[]
  emails         Email[]

  @@index([statut])
  @@index([dateSignature])
  @@index([assigneAId, statut])
  @@index([prospectId]) // FK très utilisée dans les JOINs
  @@index([statut, prospectId]) // filtre combiné fréquent
  @@map("contracts")
}

// ============================================================================
// PAYMENT — encaissement client → déclencheur des commissions
// ============================================================================

model Payment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String

  date    DateTime
  montant Decimal       @db.Decimal(12, 2)
  type    PaymentType
  statut  PaymentStatut @default(EN_ATTENTE)

  referenceFactureClient String?

  // Lien optionnel vers la facture client à laquelle ce paiement correspond
  clientInvoice   ClientInvoice? @relation(fields: [clientInvoiceId], references: [id], onDelete: SetNull)
  clientInvoiceId String?

  @@index([contractId, date])
  @@index([statut])
  @@map("payments")
}

// ============================================================================
// COMMISSION — l'enveloppe globale (1 par contrat)
// ============================================================================

model Commission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String   @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String

  /// = contract.valeurAn1 * user.tauxCommissionSignature
  montantTotal Decimal @db.Decimal(12, 2)
  /// = montantTotal / 2 (versement à la signature)
  montantPart1 Decimal @db.Decimal(12, 2)
  /// = montantTotal / 2 (étalé sur 11 mois)
  montantPart2 Decimal @db.Decimal(12, 2)

  statut CommissionStatut @default(DUE)

  // 12 CommissionPayment liés (1 signature + 11 étalements) + N renouvellement
  payments CommissionPayment[]

  @@index([userId, statut])
  @@map("commissions")
}

// ============================================================================
// COMMISSION_PAYMENT — versements individuels
// ============================================================================

model CommissionPayment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  commissionId String

  /// Numéro du mois (1-11) pour les versements ETALEMENT.
  /// Pour SIGNATURE et RENOUVELLEMENT : null (pour RENOUVELLEMENT, le mois
  /// est porté par dateVersementPrevue uniquement).
  numeroMois Int?

  typePart CommissionPaymentTypePart
  montant  Decimal                   @db.Decimal(12, 2)

  /// Date à laquelle ce versement DOIT être versé (planifié).
  dateVersementPrevue DateTime
  /// Date réelle de versement (quand statut passe à PAYE).
  dateVersement       DateTime?

  statut CommissionPaymentStatut @default(PREVU)

  /// Une fois payé, lié à l'Invoice mensuelle qui l'a intégré.
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId String?

  @@index([commissionId])
  @@index([statut, dateVersementPrevue])
  @@index([invoiceId])
  @@map("commission_payments")
}

// ============================================================================
// RENEWAL — renouvellement à l'échéance d'un contrat
// ============================================================================

model Renewal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String

  dateRenouvellement DateTime
  statut             RenewalStatut @default(A_VENIR)

  /// = contract.montantMensuel * user.tauxCommissionRenouvellement (= 10 %/mois)
  commissionAn2Mensuelle Decimal @db.Decimal(12, 2)

  raisonNonRenouvellement String? @db.Text

  @@index([contractId])
  @@index([dateRenouvellement, statut])
  @@map("renewals")
}

// ============================================================================
// INVOICE — facture INTERNE de la commerciale à ACLR Sàrl
// ============================================================================

model Invoice {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String

  /// 1er du mois facturé
  mois DateTime

  montantCommissions      Decimal @db.Decimal(12, 2)
  montantGarantieAbsorbee Decimal @db.Decimal(12, 2)
  montantFrais            Decimal @db.Decimal(12, 2)
  /// = MAX(montantCommissions, garantieMensuelle) + montantFrais
  montantTotal            Decimal @db.Decimal(12, 2)

  statut           InvoiceStatut @default(BROUILLON)
  /// Format : SOPHIE-{YYYY}-{NN} séquentiel par année
  referenceFacture String        @unique

  // Les versements de commissions intégrés dans cette facture
  commissionPayments CommissionPayment[]

  @@unique([userId, mois])
  @@index([statut])
  @@map("invoices")
}

// ============================================================================
// EMAIL_TEMPLATE
// ============================================================================

model EmailTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom     String
  type    EmailTemplateType
  objet   String
  /// Contenu avec variables {{prenomContact}}, {{raisonSociale}}, {{ville}}, etc.
  contenu String            @db.Text

  isActive Boolean @default(true)

  // Emails ayant utilisé ce template
  emails Email[]

  @@index([type])
  @@map("email_templates")
}

// ============================================================================
// EMAIL — boîte unifiée vision 360 (sortants + entrants)
// ============================================================================

model Email {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  prospectId String?

  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  contractId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String

  direction EmailDirection
  /// Identifiant de conversation pour grouper les échanges
  threadId  String
  /// RFC 5322 Message-ID — unique
  messageId String         @unique
  /// Message-ID du parent pour reconstituer le fil
  inReplyTo String?

  expediteurEmail   String
  expediteurNom     String?
  /// Peut contenir plusieurs adresses séparées par virgule
  destinataireEmail String
  cc                String?
  bcc               String?

  objet        String
  contenuHtml  String @db.Text
  contenuTexte String @db.Text

  statut   EmailStatut @default(BROUILLON)
  envoyeLe DateTime?
  livreLe  DateTime?
  ouvertLe DateTime?
  cliqueLe DateTime?

  templateUtilise   EmailTemplate? @relation(fields: [templateUtiliseId], references: [id], onDelete: SetNull)
  templateUtiliseId String?

  /// Labels libres pour filtrage (ex. ["cold-1", "relance"])
  labels String[]

  attachments EmailAttachment[]
  activities  Activity[]

  @@index([prospectId, createdAt])
  @@index([threadId])
  @@index([userId, direction])
  @@index([statut])
  @@map("emails")
}

model EmailAttachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)
  emailId String

  nom      String
  taille   Int // bytes
  mimeType String
  /// Chemin local (storage/...) ou URL S3 selon STORAGE_MODE
  url      String

  @@index([emailId])
  @@map("email_attachments")
}

// ============================================================================
// CLIENT_INVOICE — facture émise par ACLR Sàrl vers le client
// ============================================================================

model ClientInvoice {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  contractId String

  /// Format : ACLR-CLI-{YYYY}-{NNNN} séquentiel par année
  numero       String   @unique
  dateEmission DateTime
  dateEcheance DateTime

  type             ClientInvoiceType
  /// Pour les récurrents : période couverte (1er du mois début → fin du mois fin)
  periodeMoisDebut DateTime?
  periodeMoisFin   DateTime?

  /// Devise dans laquelle les montants sont libellés. Héritée du contrat
  /// au moment de la génération. CHF par défaut pour les anciennes factures.
  devise String @default("CHF") @db.VarChar(3)

  sousTotal Decimal @db.Decimal(12, 2)
  totalTVA  Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  statut            ClientInvoiceStatut @default(BROUILLON)
  datePaiement      DateTime?
  referenceVirement String?
  modeReglement     ModeReglement?

  notesClient String? @db.Text

  lignes   ClientInvoiceLine[]
  payments Payment[]

  @@index([contractId])
  @@index([statut, dateEcheance])
  @@index([dateEmission(sort: Desc)]) // tri par défaut sur la liste
  @@index([statut, dateEmission(sort: Desc)]) // filtre + tri combinés
  @@map("client_invoices")
}

model ClientInvoiceLine {
  id String @id @default(cuid())

  clientInvoice   ClientInvoice @relation(fields: [clientInvoiceId], references: [id], onDelete: Cascade)
  clientInvoiceId String

  designation  String
  quantite     Decimal @default("1") @db.Decimal(10, 2)
  prixUnitaire Decimal @db.Decimal(12, 2)
  /// = quantite * prixUnitaire (stocké pour requêtes/exports)
  montantHT    Decimal @db.Decimal(12, 2)
  /// Taux TVA appliqué sur cette ligne (0 si non assujetti)
  tauxTVA      Decimal @default("0") @db.Decimal(5, 4)

  ordre Int @default(0)

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  @@index([clientInvoiceId, ordre])
  @@map("client_invoice_lines")
}

// ============================================================================
// CONTRACT_OPTION — options et add-ons sur un contrat
// ============================================================================

model ContractOption {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String

  designation String
  type        ContractOptionType
  montant     Decimal            @db.Decimal(12, 2)
  actif       Boolean            @default(true)

  dateDebut DateTime?
  dateFin   DateTime?

  @@index([contractId, actif])
  @@map("contract_options")
}

// ============================================================================
// SIGNATURE — workflow de signature électronique d'un contrat
// ============================================================================

model Signature {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String

  type   SignatureType   @default(SIGNATURE_ELECTRONIQUE)
  statut SignatureStatut @default(BROUILLON)

  /// URL unique tokenisée pour la page publique /sign/{token}
  lienSignature String @unique

  signeParClient      Boolean   @default(false)
  dateSignatureClient DateTime?
  signeParAclr        Boolean   @default(false)
  dateSignatureAclr   DateTime?

  /// Nom complet tapé par le client au moment de la signature (audit)
  nomClient String?

  /// Signature manuscrite (PNG base64 data URL) tracée par le client
  /// à la souris/doigt/stylet sur la tablette.
  signatureClientDataUrl String?

  /// IP capturée au moment de la signature client (audit)
  ipClient String?

  /// PDF du contrat envoyé (généré par @react-pdf/renderer)
  documentPdfUrl   String
  /// PDF avec signatures apposées (post-completion)
  documentSigneUrl String?

  /// Expiration de l'invitation (default : emission + 14 jours)
  expireA DateTime

  @@index([statut])
  @@index([contractId])
  @@map("signatures")
}

// ============================================================================
// STAT — snapshot quotidien des KPIs par commerciale
// ============================================================================

model Stat {
  id   String   @id @default(cuid())
  date DateTime @db.Date

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  nbAppelsSortants Int @default(0)
  nbAppelsEntrants Int @default(0)
  nbAppelsTotal    Int @default(0)

  nbEmailsEnvoyes Int @default(0)
  nbEmailsRecus   Int @default(0)

  nbRdvPlanifies Int @default(0)
  nbRdvHonores   Int @default(0)
  nbRdvManques   Int @default(0)

  nbPropositionsEnvoyees Int @default(0)

  nbContratsSignes      Int     @default(0)
  montantContratsSignes Decimal @default("0") @db.Decimal(12, 2)

  nbProspectsNouveaux  Int @default(0)
  nbProspectsContactes Int @default(0)

  montantRenouvellementsEncaisses Decimal @default("0") @db.Decimal(12, 2)

  tauxConversionAppelRdv     Decimal @default("0") @db.Decimal(5, 4)
  tauxConversionRdvSignature Decimal @default("0") @db.Decimal(5, 4)

  @@unique([userId, date])
  @@index([date])
  @@map("stats")
}

// ============================================================================
// OBJECTIVE — objectifs commerciaux par commerciale
// ============================================================================

model Objective {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  periode   ObjectivePeriode
  dateDebut DateTime
  dateFin   DateTime

  nbAppelsObjectif       Int?
  nbEmailsObjectif       Int?
  nbRdvObjectif          Int?
  nbPropositionsObjectif Int?
  nbSignaturesObjectif   Int?
  caObjectif             Decimal? @db.Decimal(12, 2)
  commissionObjectif     Decimal? @db.Decimal(12, 2)

  notes   String? @db.Text
  isActif Boolean @default(true)

  @@index([userId, periode, dateDebut])
  @@map("objectives")
}

// ============================================================================
// SETTING — paramètres globaux ACLR Sàrl (singleton)
// ============================================================================
/// Une seule ligne attendue. La logique applicative force singleton(id=1).
model Setting {
  id        Int      @id @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Coordonnées émetteur pour les factures clients
  raisonSociale String  @default("ACLR Sàrl")
  marque        String  @default("Make Your Com")
  adresse       String?
  codePostal    String?
  ville         String?
  pays          String  @default("Suisse")
  numeroIDE     String? // CHE-XXX.XXX.XXX
  numeroTVA     String? // CHE-XXX.XXX.XXX TVA, si assujetti
  iban          String? // IBAN CHF principal
  bicSwift      String?
  nomBanque     String?
  // 2e compte multi-devises (EUR) — ACLR a un compte UBS CHF et un compte UBS EUR
  ibanEUR       String?
  bicSwiftEUR   String?

  emailContact String?
  telephone    String?
  siteWeb      String?

  logoUrl           String?
  signatureAdminUrl String?

  // Défauts métier — surchargent les constantes lib/constants.ts
  tauxCommissionSignatureDefault      Decimal @default("0.25") @db.Decimal(5, 4)
  tauxCommissionRenouvellementDefault Decimal @default("0.10") @db.Decimal(5, 4)
  garantieMensuelleDefault            Decimal @default("2500.00") @db.Decimal(12, 2)
  forfaitFraisDefault                 Decimal @default("250.00") @db.Decimal(12, 2)

  // TVA : 0 par défaut tant que ACLR n'est pas assujetti
  tvaActive Boolean @default(false)
  tauxTVA   Decimal @default("0.081") @db.Decimal(5, 4)

  /// Taux d'impôts provisionnés sur la marge brute (IBC + AVS/AI + prévoyance).
  /// Default 25 % — vision réaliste PME Suisse romande pour préparer la déclaration.
  tauxImpotsProvisionne Decimal @default("0.25") @db.Decimal(5, 4)

  @@map("settings")
}

// ============================================================================
// COUNTER — compteurs séquentiels par année pour la numérotation
// ============================================================================
/// Garantit l'unicité et la séquentialité des numéros sans recourir à un
/// SELECT MAX() qui n'est pas atomique en concurrent.
/// scope : "contract" | "client_invoice" | "sophie_invoice"
model Counter {
  scope String
  year  Int
  value Int    @default(0)

  @@id([scope, year])
  @@map("counters")
}

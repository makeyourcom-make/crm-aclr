# =============================================================================
# CRM ACLR Sàrl — Variables d'environnement (template)
# =============================================================================
# Copier ce fichier vers `.env.local` (dev) ou `.env` (prod) puis remplir.
# Ne jamais commiter le fichier rempli — il contient des secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
# DEV  : utiliser un projet Neon gratuit → https://console.neon.tech
#        Format : postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# PROD : Hetzner self-hosted → postgresql://crm:PASSWORD@postgres:5432/crm_aclr
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/crm_aclr?sslmode=require"

# URL directe (sans pooling) — requise par Prisma Migrate sur Neon
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/crm_aclr?sslmode=require"


# -----------------------------------------------------------------------------
# Authentification NextAuth (Auth.js v5)
# -----------------------------------------------------------------------------
# AUTH_SECRET : générer avec `openssl rand -base64 32` (ou `npx auth secret`)
# AUTH_URL    : URL canonique de l'app
# -----------------------------------------------------------------------------
AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"


# -----------------------------------------------------------------------------
# Resend — Emails sortants + webhooks inbound (étape 26)
# -----------------------------------------------------------------------------
# Laisser vide en dev → mode dry-run (les emails sont loggés, pas envoyés).
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_INBOUND_TOKEN=""
RESEND_FROM_EMAIL="prospects@aclr.ch"
EMAIL_MODE="dry-run"   # "dry-run" | "live"


# -----------------------------------------------------------------------------
# Stockage S3-compatible — pièces jointes emails & PDFs contrats (étape 26)
# -----------------------------------------------------------------------------
# Laisser vide en dev → stockage local sous /storage
# En prod Hetzner : utiliser Hetzner Object Storage ou un bucket Cloudflare R2
# -----------------------------------------------------------------------------
STORAGE_MODE="local"   # "local" | "s3"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET_KEY=""


# -----------------------------------------------------------------------------
# Click-to-call V2 — Twilio (optionnel, étape ultérieure)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""


# -----------------------------------------------------------------------------
# Postgres self-hosted (uniquement en prod via docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_USER="crm"
POSTGRES_PASSWORD="changeme-strong-password"
POSTGRES_DB="crm_aclr"


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
TZ="Europe/Zurich"
NODE_ENV="development"
